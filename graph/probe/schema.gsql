CREATE GRAPH Probe()
USE GRAPH Probe
CREATE SCHEMA_CHANGE JOB p1 FOR GRAPH Probe {
  ADD VERTEX PUser (PRIMARY_ID id STRING, email STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX PSource (PRIMARY_ID id STRING, title STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX PClaim (PRIMARY_ID id STRING, text STRING) WITH primary_id_as_attribute="true";
  ADD DIRECTED EDGE PREAD (FROM PUser, TO PSource) WITH REVERSE_EDGE="reverse_PREAD";
  ADD DIRECTED EDGE PMAKES (FROM PSource, TO PClaim) WITH REVERSE_EDGE="reverse_PMAKES";
}
RUN SCHEMA_CHANGE JOB p1
CREATE SCHEMA_CHANGE JOB p2 FOR GRAPH Probe {
  ALTER VERTEX PClaim ADD VECTOR ATTRIBUTE embedding(DIMENSION=3, METRIC="COSINE");
}
RUN SCHEMA_CHANGE JOB p2
