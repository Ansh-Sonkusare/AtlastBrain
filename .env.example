# Copy to apps/web/.env.local. Nothing here is a real secret.

# LLM profile: stub (offline, deterministic), local (Ollama), cheap (Haiku), demo (Sonnet + Haiku).
LLM_PROFILE=stub
ANTHROPIC_API_KEY=
COST_CAP_USD=5
OLLAMA_URL=http://127.0.0.1:11434
# qwen3:8b by default; qwen2.5:7b is the PRD's fallback.
OLLAMA_MODEL=qwen3:8b

# Embeddings: local (ONNX in-process, free, also on Vercel) or hf (Hugging Face Inference API, needs credits).
# Defaults to hf when HF_TOKEN is set, else local. Token needs the "Inference Providers" permission.
# On Vercel, also set COST_LOG=/tmp/cost.jsonl: the rest of its disk is read-only.
EMBED_PROVIDER=
HF_TOKEN=

# Novelty threshold (cosine distance). See docs/threshold.md.
NOVELTY_MAX_DIST=0.36

# TigerGraph. Cloud: set TG_URL to the instance URL and TG_SECRET to its secret. Local Docker: the URL below, TG_SECRET empty.
TG_URL=http://127.0.0.1:14240
TG_GRAPH=SecondBrain
TG_USER=tigergraph
TG_PASSWORD=tigergraph
TG_SECRET=

# Dodo Payments, test mode only. With no API key, checkout uses the local /dev/checkout stand-in.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Generate your own: echo "whsec_$(openssl rand -base64 24)". With a real Dodo key, use the secret from the Dodo dashboard.
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRO_PRODUCT_ID=
DODO_CREDITS_PRODUCT_ID=
APP_URL=http://localhost:3000

# Clerk. Copy both from the Clerk dashboard (API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signs the side panel's tokens. Generate your own: openssl rand -hex 32. Rotating it disconnects every extension.
EXTENSION_TOKEN_SECRET=
# 1 honours ?user= and x-user-id for local demos and scripts. Refused in production and on Vercel deployments.
DEMO_MODE=
# Published extension's id. Required in production, where only this id can receive a token.
NEXT_PUBLIC_EXTENSION_ID=
# Web Store listing. Unset, the install link goes to /extension/connect, which explains loading it unpacked.
NEXT_PUBLIC_EXTENSION_INSTALL_URL=
# Extension build only: the production origin it accepts connections from and calls by default.
WXT_APP_ORIGIN=
