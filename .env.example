# Copy to apps/web/.env.local. Nothing here is a real secret.

# LLM profile: stub (offline, deterministic), local (Ollama), cheap (Haiku), demo (Sonnet + Haiku).
LLM_PROFILE=stub
ANTHROPIC_API_KEY=
COST_CAP_USD=5
OLLAMA_URL=http://127.0.0.1:11434

# Novelty threshold (cosine distance). See docs/threshold.md.
NOVELTY_MAX_DIST=0.36

# TigerGraph Community Edition in Docker.
TG_URL=http://127.0.0.1:14240
TG_GRAPH=SecondBrain
TG_USER=tigergraph
TG_PASSWORD=tigergraph

# Dodo Payments, test mode only. With no API key, checkout uses the local /dev/checkout stand-in.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Generate your own: echo "whsec_$(openssl rand -base64 24)". With a real Dodo key, use the secret from the Dodo dashboard.
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRO_PRODUCT_ID=
DODO_CREDITS_PRODUCT_ID=
APP_URL=http://localhost:3000
